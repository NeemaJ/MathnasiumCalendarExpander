{
  "manifest_version": 3,
  "name": "Mathnasium Calendar Expander",
  "version": "2.5",
  "description": "Expands the Radius scheduling calendar so it prints in full without scrollbars.",
  "content_scripts": [
    {
      "matches": ["https://radius.mathnasium.com/Scheduling/Calendar*"],
      "js": ["sort-students.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://radius.mathnasium.com/Scheduling/Calendar*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
